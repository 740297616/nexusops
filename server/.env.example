# Export these variables into the process environment; this file is not loaded automatically.
NEXUSOPS_SERVER_ADDR=:8080
NEXUSOPS_VERSION=0.1.0
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nexusops
DB_PASSWORD=
DB_NAME=nexusops
# Use disable only for isolated local development. Production requires verified TLS.
DB_SSLMODE=verify-full
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=5s
AGENT_HEARTBEAT_TIMEOUT=2m
AGENT_REGISTRATION_TTL=15m
AGENT_RATE_LIMIT_WINDOW=1m
AGENT_REGISTER_RATE_LIMIT=10
AGENT_HEARTBEAT_RATE_LIMIT=120
AGENT_REPORT_RATE_LIMIT=30
AGENT_METRICS_RATE_LIMIT=60
METRICS_CLEANUP_INTERVAL=1h
METRICS_RAW_RETENTION=168h
NEXUSOPS_TRUSTED_PROXY_CIDRS=
AUTH_RATE_LIMIT_IP_MAX=20
AUTH_RATE_LIMIT_ACCOUNT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m
AUTH_CLEANUP_INTERVAL=1h
AUTH_SESSION_RETENTION=24h
AUTH_AUDIT_RETENTION=2160h
