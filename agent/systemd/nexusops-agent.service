[Unit]
Description=NexusOps Agent
After=network-online.target
Wants=network-online.target

[Service]
User=nexusops-agent
Group=nexusops-agent
ExecStart=/usr/local/bin/nexusops-agent
EnvironmentFile=/etc/nexusops-agent/agent.env
StateDirectory=nexusops-agent
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
